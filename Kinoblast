const Netz = { tot: {}, gut: {} };
const READER = [u => "https://r.jina.ai/" + u];
const PROXIES = [
  u => "https://api.allorigins.win/raw?url=" + encodeURIComponent(u),
  u => "https://api.codetabs.com/v1/proxy/?quest=" + encodeURIComponent(u),
  u => "https://corsproxy.io/?" + encodeURIComponent(u),
  u => "https://thingproxy.freeboard.io/fetch/" + u
];

function kette(roh) {
  const alle = roh ? PROXIES.slice() : READER.concat(PROXIES);
  const jetzt = Date.now();
  const pr = roh ? "p" : "r";
  const gut = [];
  const rest = [];
  alle.forEach(function (f, i) {
    const t = Netz.tot[pr + i];
    if (t && t > jetzt) return;
    if (Netz.gut[pr + i]) gut.push({ f: f, i: i });
    else rest.push({ f: f, i: i });
  });
  const sortiert = gut.concat(rest);
  if (!sortiert.length) return alle.map(function (f, i) { return { f: f, i: i }; });
  return sortiert;
}

function readerMist(txt) {
  const k = txt.slice(0, 900).toLowerCase();
  if (k.indexOf("unauthorized") !== -1) return "401";
  if (k.indexOf("too many requests") !== -1) return "429";
  if (k.indexOf("rate limit") !== -1) return "Limit";
  if (k.indexOf("just a moment") !== -1) return "Cloudflare";
  if (k.indexOf("captcha") !== -1) return "Captcha";
  return "";
}

function linksAus(text, basis) {
  const roh = [];
  let m;
  const reA = /href\s*=\s*["']([^"']+)["']/gi;
  while ((m = reA.exec(text)) !== null) roh.push(m[1]);
  const reM = /\]\((https?:\/\/[^\s)]+)\)/g;
  while ((m = reM.exec(text)) !== null) roh.push(m[1]);
  const reB = /(https?:\/\/[^\s"'<>)]{8,220})/g;
  while ((m = reB.exec(text)) !== null) roh.push(m[1]);
  const raus = [];
  const seen = new Set();
  for (let i = 0; i < roh.length; i++) {
    let u = roh[i].trim();
    if (!u || u.charAt(0) === "#") continue;
    if (u.indexOf("javascript:") === 0) continue;
    if (u.indexOf("mailto:") === 0) continue;
    try {
      u = new URL(u, basis).toString();
    } catch (e) {
      continue;
    }
    if (seen.has(u)) continue;
    seen.add(u);
    raus.push(u);
  }
  return raus;
}

async function hole(url, opt) {
  const o = opt || {};
  const timeout = o.timeout || S().timeout;
  const runden = o.runden || 1;
  const pr = o.roh ? "p" : "r";

  for (let runde = 0; runde < runden; runde++) {
    const liste = kette(o.roh);
    let letzter = "kein Weg";

    for (let n = 0; n < liste.length; n++) {
      if (Z.abbruch) return { ok: false, fehler: "abgebrochen" };
      const eintrag = liste[n];
      const ziel = eintrag.f(url);
      const istReader = ziel.indexOf("jina.ai") !== -1;
      const ctrl = new AbortController();
      const t = setTimeout(function () { ctrl.abort(); }, timeout);
      const t0 = performance.now();

      try {
        const r = await fetch(ziel, {
          signal: ctrl.signal,
          headers: { Accept: "text/html,application/json,text/plain,*/*" },
          cache: "no-store"
        });
        clearTimeout(t);

        if (!r.ok) {
          letzter = "HTTP " + r.status;
          Netz.tot[pr + eintrag.i] = Date.now() + 300000;
          delete Netz.gut[pr + eintrag.i];
          continue;
        }

        const txt = await r.text();
        if (!txt || txt.length < 120) {
          letzter = "leer";
          continue;
        }

        if (istReader) {
          const mist = readerMist(txt);
          if (mist) {
            letzter = "Reader " + mist;
            Netz.tot[pr + eintrag.i] = Date.now() + 120000;
            delete Netz.gut[pr + eintrag.i];
            continue;
          }
          if (linksAus(txt, url).length < 3) {
            letzter = "Reader ohne Links";
            continue;
          }
        }

        Netz.gut[pr + eintrag.i] = Date.now();
        return { ok: true, text: txt, dauer: performance.now() - t0 };
      } catch (e) {
        clearTimeout(t);
        letzter = e && e.name === "AbortError" ? "Timeout" : ((e && e.message) || "Fehler");
        Netz.tot[pr + eintrag.i] = Date.now() + 300000;
        delete Netz.gut[pr + eintrag.i];
      }
    }

    if (runde + 1 < runden) {
      await new Promise(function (r) { setTimeout(r, 350); });
    } else {
      return { ok: false, fehler: letzter };
    }
  }

  return { ok: false, fehler: "kein Weg" };
}

async function portalSuchen(p, q) {
  const url = p.s(q);
  const r = await hole(url, { timeout: S().timeout, runden: 1 });
  if (!r.ok) {
    lernF(p.id, r.fehler);
    return { p: p, ok: false, fehler: r.fehler };
  }
  lernO(p.id);
  return { p: p, ok: true, text: r.text, url: url };
}

function trefferAus(a, q) {
  const raus = [];
  if (!a || !a.ok) return raus;
  const links = linksAus(a.text, a.url);
  const seen = new Set();
  for (let i = 0; i < links.length; i++) {
    const u = links[i];
    if (istWerbung(u)) continue;
    if (!/^https?:/i.test(u)) continue;
    if (hosterAus(u) && !istDatei(u)) continue;
    if (/\.(css|js|png|jpe?g|gif|svg|ico|woff2?)(\?|$)/i.test(u)) continue;
    const seg = u.replace(/^https?:\/\/[^/]+/, "").split("/").filter(Boolean);
    if (!seg.length) continue;
    let roh = seg[seg.length - 1];
    if (seg.length > 1 && /^(film|serie|stream|watch|movie|title|staffel|episode)$/i.test(roh)) {
      roh = seg[seg.length - 2];
    }
    const tit = titelAus(decodeURIComponent(roh));
    if (tit.length < 3) continue;
    const s = aehnlich(tit, q);
    if (s < 0.3) continue;
    const k = norm(tit);
    if (seen.has(k)) continue;
    seen.add(k);
    raus.push({
      titel: tit,
      url: sauber(u),
      portal: a.p.name,
      pid: a.p.id,
      score: s,
      hoster: [],
      geprueft: false,
      katalog: false
    });
  }
  return raus;
}

async function quellen(t) {
  if (t.geprueft) return t;
  t.geprueft = true;
  const r = await hole(t.url, { timeout: S().timeout, runden: 2 });
  if (!r.ok) {
    t.fehler = r.fehler;
    return t;
  }
  const links = linksAus(r.text, t.url);
  const seen = new Set();
  for (let i = 0; i < links.length; i++) {
    const h = hosterAus(links[i]);
    if (!h || seen.has(h.id)) continue;
    seen.add(h.id);
    t.hoster.push({ id: h.id, name: h.name, url: sauber(links[i]) });
  }
  if (!t.hoster.length) {
    links.filter(istDatei).slice(0, 3).forEach(function (d) {
      t.hoster.push({ id: "d", name: "Direkt", url: d });
    });
  }
  return t;
}

async function pool(liste, n, fn) {
  const raus = new Array(liste.length);
  let i = 0;
  const w = [];
  const grenze = Math.max(1, Math.min(n, liste.length));
  for (let k = 0; k < grenze; k++) {
    w.push((async function () {
      while (i < liste.length) {
        const idx = i++;
        if (Z.abbruch) {
          raus[idx] = null;
          continue;
        }
        try {
          raus[idx] = await fn(liste[idx], idx);
        } catch (e) {
          raus[idx] = null;
        }
      }
    })());
  }
  await Promise.all(w);
  return raus;
}

function lernO(id) {
  const d = Store.lesen();
  d.lern = d.lern || {};
  const e = d.lern[id] || { ok: 0, f: 0 };
  e.ok++;
  d.lern[id] = e;
  Store.schreiben(d);
}

function lernF(id, g) {
  const d = Store.lesen();
  d.lern = d.lern || {};
  const e = d.lern[id] || { ok: 0, f: 0 };
  e.f++;
  e.g = g;
  d.lern[id] = e;
  Store.schreiben(d);
}

function lernW(id) {
  const e = (Store.lesen().lern || {})[id];
  if (!e || !(e.ok + e.f)) return 0.5;
  return (e.ok + 1) / (e.ok + e.f + 2);
}

function hO(id) {
  const d = Store.lesen();
  d.hoster = d.hoster || {};
  const e = d.hoster[id] || { ok: 0, f: 0 };
  e.ok++;
  d.hoster[id] = e;
  Store.schreiben(d);
}

function hF(id) {
  const d = Store.lesen();
  d.hoster = d.hoster || {};
  const e = d.hoster[id] || { ok: 0, f: 0 };
  e.f++;
  d.hoster[id] = e;
  Store.schreiben(d);
}

function hW(id) {
  const e = (Store.lesen().hoster || {})[id];
  if (!e || !(e.ok + e.f)) return 0.5;
  return (e.ok + 1) / (e.ok + e.f + 2);
}

function tO(falsch, richtig) {
  if (!falsch || !richtig) return;
  const d = Store.lesen();
  d.titelmap = d.titelmap || {};
  d.titelmap[norm(falsch)] = richtig;
  Store.schreiben(d);
}

function tW(falsch) {
  const m = Store.lesen().titelmap || {};
  return m[norm(falsch)] || "";
}

async function kiFrage(system, nutzer) {
  const s = S();
  if (!s.key) return null;
  try {
    const r = await fetch(s.endpoint || VORG.endpoint, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: "Bearer " + s.key
      },
      body: JSON.stringify({
        model: s.modell || VORG.modell,
        temperature: 0.2,
        messages: [
          { role: "system", content: system },
          { role: "user", content: nutzer }
        ]
      })
    });
    if (!r.ok) {
      schritt("KI antwortet HTTP " + r.status, "w");
      return null;
    }
    const j = await r.json();
    const c = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content;
    return c ? String(c).trim() : null;
  } catch (e) {
    schritt("KI-Fehler: " + e.message, "w");
    return null;
  }
}

async function kiKandidaten(q) {
  if (!S().key || !S().kirang) return [];
  const a = await kiFrage(
    "Du kennst Filme und Serien. Nenne bis zu 4 wahrscheinliche Titel für die Eingabe. Antworte nur mit Titeln, einer pro Zeile, ohne Nummern.",
    "Eingabe: " + q
  );
  if (!a) return [];
  const raus = [];
  a.split("\n").forEach(function (z) {
    const t = z.replace(/^[\d.\-–)\s]+/, "").replace(/["']/g, "").trim();
    if (t.length > 1 && t.length < 80) raus.push(t);
  });
  return raus.slice(0, 4);
}

async function kiRang(k) {
  if (!S().key || !S().kirang || k.length < 2) return null;
  const zeilen = k.map(function (x, i) {
    return (i + 1) + ". " + x.hoster.name + " über " + x.treffer.portal + (istVideo(x.hoster.url) ? " (Direktlink)" : "");
  }).join("\n");
  const a = await kiFrage(
    "Bewerte Downloadquellen für Filme. Antworte nur mit den Nummern, beste zuerst, durch Komma getrennt.",
    zeilen
  );
  if (!a) return null;
  const nums = a.match(/\d+/g) || [];
  const reihe = [];
  nums.forEach(function (n) {
    const i = Number(n) - 1;
    if (i >= 0 && i < k.length && reihe.indexOf(i) === -1) reihe.push(i);
  });
  if (!reihe.length) return null;
  for (let i = 0; i < k.length; i++) if (reihe.indexOf(i) === -1) reihe.push(i);
  schritt("KI hat die Quellen sortiert", "o");
  return reihe;
}

function katalog(q) {
  const k = kernTitel(q);
  if (norm(k).length < 2) return [];
  const raus = [];
  KATALOG.forEach(function (e) {
    const s = Math.max(aehnlich(e.t, k), aehnlich(e.t, q));
    if (s < 0.45) return;
    raus.push({
      titel: e.t + " (" + e.y + ")",
      url: "",
      portal: "Katalog",
      pid: "katalog",
      score: Math.min(0.99, s * 0.95),
      hoster: [],
      geprueft: true,
      katalog: true,
      genre: e.g,
      jahr: e.y
    });
  });
  raus.sort(function (a, b) { return b.score - a.score; });
  return raus.slice(0, 8);
}

function wert(k) {
  let w = 0.08;
  if (istVideo(k.hoster.url)) w += 0.32;
  if (k.hoster.id === "d" || k.hoster.id === "offen") w += 0.1;
  w += hW(k.hoster.id) * 0.3;
  w += lernW(k.treffer.pid) * 0.18;
  w += k.treffer.score * 0.15;
  if (k.treffer.katalog) w += 0.05;
  return Math.max(0, Math.min(1, w));
}

function kandidaten() {
  const raus = [];
  Z.treffer.forEach(function (t) {
    if (t.katalog) {
      const tn = t.titel.replace(/\s*\(\d{4}\)$/, "");
      const u = OFFEN[tn];
      if (u) {
        raus.push({ treffer: t, hoster: { id: "offen", name: "Direkt-MP4", url: u } });
      } else {
        const p = besterPortal();
        if (p) raus.push({ treffer: t, hoster: { id: "portal:" + p.id, name: p.name, url: p.s(tn) } });
      }
      return;
    }
    t.hoster.forEach(function (h) {
      raus.push({ treffer: t, hoster: h });
    });
  });
  return raus;
}
