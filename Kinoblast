  if (!t && !text) { meldung("Titel oder Text nötig"); return; }

  const d = Store.lesen();
  d.meldungen = d.meldungen || [];
  d.meldungen.unshift({ t: t, art: art, quelle: quelle, text: text, zeit: Date.now() });
  Store.schreiben(d);

  if (art === "hostertot" && quelle) {
    const h = HOSTER.filter(function (x) { return norm(x.name) === norm(quelle); })[0];
