    if (!document.querySelector(".page.on")) zeige("suche");
    const d = Store.lesen();
    if (!d.einstellungen) Store.setzen("einstellungen", {});
    if (!Array.isArray(d.watchlist)) Store.setzen("watchlist", []);
    if (!Array.isArray(d.verlauf)) Store.setzen("verlauf", []);
    if (!Array.isArray(d.meldungen)) Store.setzen("meldungen", []);
    if (typeof d.lern !== "object" || d.lern === null) Store.setzen("lern", {});
    if (typeof d.hoster !== "object" || d.hoster === null) Store.setzen("hoster", {});
    if (typeof d.titelmap !== "object" || d.titelmap === null) Store.setzen("titelmap", {});
    if (typeof d.zaehler !== "object" || d.zaehler === null) Store.setzen("zaehler", {});
    if (zaehlen) Store.zahl("rep", 1);
  },
  lauf: function () {
    const b = this.pruefe();
    if (!b.length) return true;
    this.rep(true);
    const b2 = this.pruefe();
    return !b2.length;
  }
};

function banner(c, x) {
  const b = $("banner");
  if (!b) return;
  b.className = c || "";
  b.textContent = x;
}

async function selbsttest() {
  const ok = Sup.lauf();
  const sp = Store.ok();
  const nz = navigator.onLine !== false;
  const teile = [
    "Struktur " + (ok ? "ok" : "repariert"),
    "Seiten " + document.querySelectorAll(".page").length,
    "Speicher " + (sp ? "ok" : "Sitzung"),
    "Netz " + (nz ? "online" : "offline")
  ];
  if (ok && sp && nz) {
    banner("gut", "Selbsttest bestanden · " + teile.join(" · "));
    log("o", "Selbsttest bestanden");
  } else if (nz) {
    banner("warn", "Eingeschränkt · " + teile.join(" · "));
  } else {
    banner("schlecht", "Offline · " + teile.join(" · "));
  }
}

function start() {
  try {
    namen().forEach(bauSeite);
    Sup.rep(false);
    zeige("suche");
    fuelle();
    log("o", "Kinolotse " + APP.version + " gestartet");
    log("i", "Portale " + PORTALE.length + " · Hoster " + HOSTER.length + " · Katalog " + KATALOG.length);
    selbsttest();
    setInterval(function () {
      if (Sup.pruefe().length) Sup.rep(true);
    }, 120000);
    window.addEventListener("online", selbsttest);
    window.addEventListener("offline", function () {
      banner("schlecht", "Verbindung verloren.");
    });
  } catch (e) {
    log("e", "Startfehler: " + e.message);
    banner("schlecht", "Startfehler: " + e.message);
  }
}

document.addEventListener("click", function (e) {
  const b = e.target && e.target.closest ? e.target.closest("#nav button") : null;
  if (!b) return;
  const p = b.getAttribute("data-page");
  if (p) zeige(p);
});

if ($("konsole-leeren")) {
  $("konsole-leeren").addEventListener("click", function () {
    if ($("konsole")) $("konsole").innerHTML = "";
  });
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", start);
} else {
  start();
}
</script>
</body>
</html>
