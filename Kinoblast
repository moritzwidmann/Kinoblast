function sortiere(l) {
  const a = l.slice();
  if (Z.sort === "titel") a.sort(function (x, y) { return x.titel.localeCompare(y.titel, "de"); });
  else if (Z.sort === "jahr") a.sort(function (x, y) { return (y.jahr || 0) - (x.jahr || 0); });
  else if (Z.sort === "portal") a.sort(function (x, y) { return x.portal.localeCompare(y.portal, "de"); });
  else a.sort(function (x, y) { return y.score - x.score; });
  return a;
}

