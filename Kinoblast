async function starte() {
  if (Z.laeuft) { meldung("Läuft schon"); return; }
  const f = $("q");
  if (!f) return;
  const eingabe = f.value.trim();
  if (eingabe.length < 2) { meldung("Mindestens 2 Zeichen"); return; }

  Z.laeuft = true;
  Z.abbruch = false;
  Z.treffer = [];
  Z.zaehler = 0;
  Z.bericht = [];
  Z.fehler = [];
  Z.best = null;
  Z.bestListe = [];
  Z.bestIdx = 0;
  zaehle();
  if ($("abbrechen")) $("abbrechen").disabled = false;
  if ($("start")) $("start").disabled = true;
  if ($("lauf")) $("lauf").classList.add("an");
  if ($("lauf-schritte")) $("lauf-schritte").innerHTML = "";
  if ($("treffer")) $("treffer").innerHTML = "";
  aktionLeer("Suche läuft …");
  fortschritt(3, "Start");
  status("suche", false);
  Store.zahl("suchen", 1);

  try {
    const gemerkt = tW(eingabe);
    let q = kernTitel(eingabe);
    if (gemerkt && norm(gemerkt) !== norm(q)) {
      schritt("Gelernte Korrektur: " + gemerkt, "o");
      q = gemerkt;
    }
    if (norm(q) !== norm(eingabe)) schritt("Bereinigt zu: „" + q + "“", "i");

    fortschritt(8, "Katalog");
    if (S().katalog) {
      const k = katalog(q);
      Z.bericht.push({ quelle: "Katalog", ergebnis: k.length + " Treffer", ok: k.length > 0 });
      schritt("Katalog: " + k.length + " Treffer", k.length ? "o" : "i");
      if (k.length) {
        Z.treffer = k.slice();
        Z.zaehler = k.length;
        zaehle();
      }
    }

    const akt = PORTALE.filter(function (p) { return S().portale[p.id]; });
    if (akt.length) {
      fortschritt(16, "Portale werden abgefragt");
      let fertig = 0;
      const ant = await pool(akt, S().parallel, async function (p) {
        const r = await portalSuchen(p, q);
        fertig++;
        fortschritt(16 + Math.round((fertig / akt.length) * 34), "Portale " + fertig + "/" + akt.length);
        return r;
      });

      let live = [];
      ant.forEach(function (a) {
        if (!a) return;
        if (!a.ok) {
          Z.bericht.push({ quelle: a.p.name, ergebnis: a.fehler, ok: false });
          schritt(a.p.name + ": " + a.fehler, "e");
          return;
        }
        const r = trefferAus(a, q);
        Z.bericht.push({ quelle: a.p.name, ergebnis: r.length + " Treffer", ok: r.length > 0 });
        if (r.length) {
          schritt(a.p.name + ": " + r.length + " Treffer", "o");
          live = live.concat(r);
        } else {
          schritt(a.p.name + ": keine Treffer", "w");
        }
      });

      if (!live.length && !Z.treffer.length) {
        fortschritt(52, "Zweite Welle");
        schritt("Erste Welle leer, starte Varianten", "w");

        const kand = (await kiKandidaten(q)).concat(lokalKandidaten(q));
        const vars = varianten(eingabe).concat(kand);
        const seen = new Set([norm(q)]);
        const nutz = [];
        vars.forEach(function (v) {
          const n = norm(v);
          if (!n || seen.has(n)) return;
          seen.add(n);
          nutz.push(v);
        });
        if (!nutz.length) schritt("Keine Varianten gefunden", "w");

        const ziel = besterPortal();
        for (let i = 0; i < nutz.length && i < 3; i++) {
          if (Z.abbruch) break;
          schritt("Variante: „" + nutz[i] + "“", "i");
          if (!ziel) break;
          const a2 = await portalSuchen(ziel, nutz[i]);
          if (a2.ok) {
            const r2 = trefferAus(a2, nutz[i]);
            if (r2.length) {
              schritt("Variante brachte " + r2.length + " Treffer", "o");
              tO(eingabe, nutz[i]);
              live = live.concat(r2);
              break;
            }
          }
          fortschritt(52 + (i + 1) * 4, "Variante " + (i + 1));
        }
      }

      if (live.length) {
        fortschritt(62, "Treffer bündeln");
        const best = new Map();
        live.forEach(function (x) {
          const k = norm(x.titel);
          const a = best.get(k);
          if (!a || x.score > a.score) best.set(k, x);
        });
        let l = Array.from(best.values());
        l.forEach(function (x) {
          x.score = Math.min(1, x.score * 0.75 + lernW(x.pid) * 0.25);
        });
        l = l.filter(function (x) { return x.score >= S().score; }).slice(0, S().max);
        Z.treffer = Z.treffer.concat(l);
        Z.zaehler = Z.treffer.length;
        zaehle();
      }
    }

    if (!Z.treffer.length) {
      fortschritt(100, "fertig ohne Treffer");
      fehlerBox(q);
      if ($("treffer")) $("treffer").innerHTML = '<div class="leer">Kein Treffer. Ausweichlinks stehen oben.</div>';
      return;
    }

    fortschritt(66, "Quellen holen");
    const offen = Z.treffer.filter(function (t) { return !t.katalog && !t.geprueft; }).slice(0, 4);
    let geholt = 0;
    await pool(offen, 2, async function (t) {
      await quellen(t);
      geholt++;
      fortschritt(66 + Math.round((geholt / Math.max(1, offen.length)) * 16), "Quellen " + geholt + "/" + offen.length);
      if (t.hoster.length) schritt(t.portal + ": " + t.hoster.length + " Hoster", "o");
      else schritt(t.portal + ": keine Hoster (" + (t.fehler || "leer") + ")", "e");
    });

    fortschritt(84, "Bewerten");
    let kand2 = kandidaten();
    kand2.forEach(function (x) { x.wert = wert(x); });
    kand2.sort(function (a, b) { return b.wert - a.wert; });

    if (kand2.length > 1 && S().key && S().kirang) {
      fortschritt(90, "KI sortiert");
      const reihe = await kiRang(kand2.slice(0, 6));
      if (reihe) {
        const top = reihe.map(function (i) { return kand2[i]; }).filter(Boolean);
        const rest = kand2.filter(function (x) { return top.indexOf(x) === -1; });
        kand2 = top.concat(rest);
      }
    }

    Z.bestListe = kand2;
    Z.bestIdx = 0;
    Z.best = kand2.length ? kand2[0] : null;

    if (!Z.best) {
      fortschritt(100, "keine Quelle");
      fehlerBox(q);
      return;
    }

    fortschritt(100, "fertig");
    schritt("Beste Quelle: " + Z.best.hoster.name + " (" + Math.round(Z.best.wert * 100) + "%)", "o");
    aktionKarte(Z.best, 0, Z.bestListe.length);
    zeichne();

    const v = Store.lesen().verlauf || [];
    v.unshift({ q: q, n: Z.treffer.length, t: Date.now() });
    Store.setzen("verlauf", v.slice(0, 60));
  } catch (e) {
    fortschritt(100, "Fehler");
    schritt("Fehler: " + e.message, "e");
    fehlerBox(kernTitel(eingabe));
  } finally {
    Z.laeuft = false;
    if ($("abbrechen")) $("abbrechen").disabled = true;
    if ($("start")) $("start").disabled = false;
    status("bereit", false);
  }
}

function zeichne() {
  const box = $("treffer");
  if (!box) return;
  box.innerHTML = "";
  let liste = Z.treffer;
  if (Z.genre) liste = liste.filter(function (x) { return x.genre === Z.genre; });
  if (Z.az) liste = liste.filter(function (x) { return norm(x.titel).charAt(0).toUpperCase() === Z.az; });
  if (Z.nurDirekt) liste = liste.filter(function (x) {
    if (x.katalog) return !!OFFEN[x.titel.replace(/\s*\(\d{4}\)$/, "")];
    return x.hoster.some(function (h) { return istVideo(h.url); });
  });
  liste = sortiere(liste);
  box.appendChild(el("div", "hinweis", liste.length + " Treffer angezeigt"));
  if (!liste.length) {
    box.appendChild(el("div", "leer", "Kein Treffer in diesem Filter."));
    return;
  }
  liste.forEach(function (t) {
    const k = el("div", "karte");
    k.appendChild(el("b", "", t.titel));
    const m = el("div", "meta");
    m.appendChild(el("span", "pille " + (t.score > 0.7 ? "gut" : t.score > 0.5 ? "mittel" : "schlecht"), Math.round(t.score * 100) + "%"));
    m.appendChild(document.createTextNode(t.portal + (t.genre ? " · " + t.genre : "")));
    k.appendChild(m);
    const r = el("div", "hoster");
    if (t.url) {
      const s = el("a", "", "Seite");
      s.href = t.url;
      s.target = "_blank";
      s.rel = "noopener noreferrer";
      r.appendChild(s);
    }
    if (t.katalog) {
      const tn = t.titel.replace(/\s*\(\d{4}\)$/, "");
      PORTALE.filter(function (p) { return S().portale[p.id]; }).slice(0, 3).forEach(function (p) {
        const a = el("a");
        a.href = p.s(tn);
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = p.name;
        r.appendChild(a);
      });
    }
    t.hoster.forEach(function (h) {
      const a = document.createElement("a");
      if (istVideo(h.url)) a.className = "mp4";
      a.href = h.url;
      if (istVideo(h.url)) {
        a.download = t.titel + ".mp4";
        a.type = "video/mp4";
      } else {
        a.target = "_blank";
      }
      a.rel = "noopener noreferrer";
      a.appendChild(el("b", "", h.name));
      a.appendChild(document.createTextNode(istVideo(h.url) ? " Video" : " öffnen"));
      a.addEventListener("click", function () {
        hO(h.id);
        lernO(t.pid);
      });
      r.appendChild(a);
    });
    const w = el("span", "lnk", "+ Watchlist");
    w.addEventListener("click", function () { wlSpeichern(t.titel); });
    r.appendChild(w);
    k.appendChild(r);
    box.appendChild(k);
  });
}

