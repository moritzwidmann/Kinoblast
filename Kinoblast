<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#070b09">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="format-detection" content="telephone=no">
<title>Kinolotse 18</title>
<style>
:root{
  --bg:#070b09;
  --bg2:#0d1410;
  --bg3:#121b16;
  --bg4:#18241d;
  --line:#1e2b23;
  --line2:#2b3d32;
  --line3:#3a5142;
  --fg:#e6f2ea;
  --fg2:#9db3a7;
  --fg3:#6d8478;
  --acc:#25d07a;
  --warn:#e0b23c;
  --err:#e2604f;
  --rad:12px;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}
html,body{
  margin:0;
  padding:0;
}
body{
  background:var(--bg);
  color:var(--fg);
  min-height:100vh;
  overflow-x:hidden;
  font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  padding-bottom:250px;
  -webkit-text-size-adjust:100%;
}
h1,h2,h3{
  margin:0 0 .5em;
  line-height:1.25;
  font-weight:650;
}
h1{font-size:1.5rem}
h2{font-size:1.12rem}
h3{
  font-size:.9rem;
  color:var(--fg2);
  text-transform:uppercase;
  letter-spacing:.09em;
  font-weight:600;
}
p{margin:0 0 .8em}
a{color:var(--acc);text-decoration:none}
header{
  position:sticky;
  top:0;
  z-index:40;
  background:#070b09f2;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
  padding:12px 14px 0;
}
.kopf{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:10px;
}
.logo{
  width:30px;
  height:30px;
  border-radius:9px;
  flex:0 0 auto;
  display:grid;
  place-items:center;
  font-weight:800;
  color:#04140c;
  font-size:15px;
  background:radial-gradient(circle at 30% 25%,#2ee98b,#0d7a47 70%);
  box-shadow:0 0 0 1px #2ee98b40;
}
.kopf h1{
  font-size:1.05rem;
  margin:0;
}
.kopf .ver{
  margin-left:auto;
  font-family:var(--mono);
  font-size:.68rem;
  color:var(--fg3);
  border:1px solid var(--line);
  border-radius:6px;
  padding:2px 6px;
}
nav{
  display:flex;
  gap:6px;
  overflow-x:auto;
  padding-bottom:10px;
  scrollbar-width:none;
}
nav::-webkit-scrollbar{display:none}
nav button{
  flex:0 0 auto;
  background:var(--bg2);
  color:var(--fg2);
  border:1px solid var(--line);
  border-radius:999px;
  padding:7px 13px;
  font-size:.82rem;
  font-weight:550;
  cursor:pointer;
  white-space:nowrap;
  font-family:inherit;
}
nav button.active{
  background:var(--acc);
  color:#04140c;
  border-color:var(--acc);
}
nav button:active{transform:scale(.96)}
main{
  padding:16px 14px 0;
  max-width:860px;
  margin:0 auto;
}
.page{display:none}
.page.on{display:block}
.feld{
  display:flex;
  gap:8px;
  margin-bottom:12px;
}
input[type=text],
input[type=password],
input[type=number],
input[type=url],
select,
textarea{
  width:100%;
  background:var(--bg2);
  color:var(--fg);
  border:1px solid var(--line2);
  border-radius:10px;
  padding:11px 12px;
  font-size:.95rem;
  font-family:inherit;
}
input:focus,
select:focus,
textarea:focus{
  outline:none;
  border-color:var(--acc);
  box-shadow:0 0 0 3px #25d07a1f;
}
textarea{
  resize:vertical;
  min-height:90px;
  font-family:var(--mono);
  font-size:.78rem;
}
label.zeile{
  display:block;
  margin-bottom:12px;
}
label.zeile>span{
  display:block;
  font-size:.78rem;
  color:var(--fg2);
  margin-bottom:5px;
  font-weight:550;
}
button.btn{
  background:var(--acc);
  color:#04140c;
  border:0;
  border-radius:10px;
  padding:11px 16px;
  font-size:.9rem;
  font-weight:650;
  cursor:pointer;
  font-family:inherit;
}
button.btn:active{transform:scale(.97)}
button.btn[disabled]{
  opacity:.5;
  cursor:default;
  transform:none;
}
button.btn.ghost{
  background:var(--bg2);
  color:var(--fg);
  border:1px solid var(--line2);
}
button.btn.rot{
  background:var(--err);
  color:#1a0603;
}
button.btn.klein{
  padding:6px 10px;
  font-size:.78rem;
  border-radius:8px;
}
.karte{
  background:var(--bg2);
  border:1px solid var(--line);
  border-radius:var(--rad);
  padding:13px;
  margin-bottom:10px;
}
.karte .meta{
  font-size:.75rem;
  color:var(--fg3);
  margin-top:3px;
  font-family:var(--mono);
}
.pille{
  display:inline-block;
  font-size:.7rem;
  font-family:var(--mono);
  padding:2px 7px;
  border-radius:999px;
  border:1px solid var(--line2);
  color:var(--fg2);
  margin-right:5px;
}
.pille.gut{
  color:var(--acc);
  border-color:#25d07a55;
  background:#25d07a12;
}
.pille.mittel{
  color:var(--warn);
  border-color:#e0b23c55;
  background:#e0b23c12;
}
.pille.schlecht{
  color:var(--err);
  border-color:#e2604f55;
  background:#e2604f12;
}
.hoster{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:9px;
}
.hoster a,
.hoster span.lnk{
  font-size:.78rem;
  padding:7px 11px;
  border-radius:8px;
  background:var(--bg3);
  border:1px solid var(--line2);
  color:var(--fg);
  display:inline-flex;
  align-items:center;
  gap:5px;
  cursor:pointer;
}
.hoster a b{color:var(--acc);font-weight:600}
.hoster a.mp4{
  border-color:var(--acc);
  background:#25d07a18;
  color:#c8f7dd;
}
.leer{
  text-align:center;
  color:var(--fg3);
  padding:26px 12px;
  font-size:.88rem;
}
#banner{
  border-radius:10px;
  padding:10px 12px;
  font-size:.8rem;
  margin-bottom:14px;
  border:1px solid var(--line2);
  background:var(--bg2);
  color:var(--fg2);
  font-family:var(--mono);
  line-height:1.5;
}
#banner.gut{
  border-color:#25d07a55;
  background:#25d07a0e;
  color:#a9f2cb;
}
#banner.schlecht{
  border-color:#e2604f55;
  background:#e2604f0e;
  color:#f6b6ac;
}
#banner.warn{
  border-color:#e0b23c55;
  background:#e0b23c0e;
  color:#f0d59a;
}
table{
  width:100%;
  border-collapse:collapse;
  font-size:.78rem;
  font-family:var(--mono);
}
th,td{
  text-align:left;
  padding:6px 5px;
  border-bottom:1px solid var(--line);
}
th{
  color:var(--fg3);
  font-weight:600;
  font-size:.7rem;
  text-transform:uppercase;
}
td.w{
  color:var(--fg2);
  word-break:break-word;
}
footer{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:45;
  background:#060a08f5;
  backdrop-filter:blur(12px);
  border-top:1px solid var(--line);
  padding-bottom:env(safe-area-inset-bottom);
}
.kopfkonsole{
  display:flex;
  align-items:center;
  gap:8px;
  padding:6px 12px;
  border-bottom:1px solid var(--line);
  font-size:.72rem;
  font-family:var(--mono);
  color:var(--fg3);
}
.kopfkonsole .p{
  display:flex;
  align-items:center;
  gap:5px;
}
.kopfkonsole .p i{
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--acc);
  display:inline-block;
}
.kopfkonsole .p.b i{background:var(--err)}
.kopfkonsole button{
  margin-left:auto;
  background:none;
  border:1px solid var(--line2);
  color:var(--fg3);
  border-radius:6px;
  padding:2px 8px;
  font-size:.7rem;
  cursor:pointer;
  font-family:var(--mono);
}
#konsole{
  height:120px;
  overflow-y:auto;
  padding:6px 12px;
  font-family:var(--mono);
  font-size:.72rem;
  line-height:1.5;
}
#konsole .z{
  display:flex;
  gap:7px;
  padding:1px 0;
  word-break:break-word;
}
#konsole .z time{
  color:var(--fg3);
  flex:0 0 auto;
}
#konsole .z.i{color:var(--fg2)}
#konsole .z.o{color:var(--acc)}
#konsole .z.w{color:var(--warn)}
#konsole .z.e{color:var(--err)}
#toast{
  position:fixed;
  left:50%;
  bottom:210px;
  transform:translate(-50%,20px);
  background:#e6f2ea;
  color:#070b09;
  font-size:.82rem;
  font-weight:600;
  padding:10px 16px;
  border-radius:999px;
  z-index:60;
  opacity:0;
  pointer-events:none;
  transition:.22s;
  max-width:88vw;
  text-align:center;
}
#toast.on{
  opacity:1;
  transform:translate(-50%,0);
}
.hinweis{
  font-size:.78rem;
  color:var(--fg3);
  line-height:1.5;
}
.reihe{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:12px;
}
.reihe button{flex:1 1 auto}
.box{
  background:var(--bg2);
  border:1px solid var(--line);
  border-radius:var(--rad);
  padding:13px;
  margin-bottom:12px;
}
.trenner{
  height:1px;
  background:var(--line);
  margin:14px 0;
}
.balken{
  height:9px;
  background:var(--bg3);
  border:1px solid var(--line);
  border-radius:999px;
  overflow:hidden;
  margin:8px 0;
}
.balken i{
  display:block;
  height:100%;
  width:0;
  background:var(--acc);
  transition:width .25s;
}
.chips{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:12px;
}
.chips button{
  font-size:.76rem;
  padding:5px 10px;
  border-radius:999px;
  background:var(--bg3);
  border:1px solid var(--line2);
  color:var(--fg2);
  cursor:pointer;
  font-family:inherit;
}
.chips button.an{
  background:var(--acc);
  color:#04140c;
  border-color:var(--acc);
}
.chips.az button{
  min-width:30px;
  justify-content:center;
  display:inline-flex;
}
video{
  width:100%;
  border-radius:10px;
  background:#000;
  border:1px solid var(--line2);
  aspect-ratio:16/9;
}
.kpi{
  background:var(--bg2);
  border:1px solid var(--line);
  border-radius:var(--rad);
  padding:12px;
  margin-bottom:10px;
}
.kpi b{
  font-family:var(--mono);
  color:var(--acc);
  font-size:1.4rem;
  display:block;
}
.kpi small{
  color:var(--fg3);
  font-size:.72rem;
  font-family:var(--mono);
}
#lauf{display:none}
#lauf.an{display:block}
.schritte{
  font-family:var(--mono);
  font-size:.72rem;
  line-height:1.6;
  max-height:190px;
  overflow-y:auto;
  margin-top:8px;
  border-top:1px solid var(--line);
  padding-top:8px;
}
.schritte div{
  display:flex;
  gap:7px;
  padding:1px 0;
  word-break:break-word;
}
.schritte .m{
  flex:0 0 auto;
  width:14px;
  text-align:center;
}
.schritte .o .m{color:var(--acc)}
.schritte .e .m{color:var(--err)}
.schritte .w .m{color:var(--warn)}
.schritte .i .m{color:var(--fg3)}
.schritte .i{color:var(--fg2)}
.schritte .e{color:#f0a99e}
.schritte .o{color:#a9f2cb}
.dlknopf{display:block;text-decoration:none}
.dlknopf .gross{
  display:flex;
  width:100%;
  align-items:center;
  justify-content:center;
  gap:9px;
  background:var(--acc);
  color:#04140c;
  border:0;
  border-radius:12px;
  padding:17px;
  font-size:1.02rem;
  font-weight:750;
  font-family:inherit;
  cursor:pointer;
  text-align:center;
}
.dlknopf .gross:active{transform:scale(.98)}
.aktion{
  background:linear-gradient(180deg,#12261c,#0d1a14);
  border:1px solid var(--acc);
  border-radius:14px;
  padding:15px;
  margin-bottom:14px;
}
.aktion .kopfz{
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:6px;
}
.aktion .kopfz span{
  font-size:.7rem;
  font-family:var(--mono);
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--acc);
}
.aktion .titel{
  font-size:1.08rem;
  font-weight:700;
  line-height:1.3;
  margin-bottom:5px;
  word-break:break-word;
}
.aktion .quelle{
  font-size:.78rem;
  font-family:var(--mono);
  color:var(--fg2);
  margin-bottom:11px;
}
.aktion .quelle b{color:var(--acc)}
.aktion .zweit{
  display:flex;
  gap:8px;
  margin-top:9px;
  flex-wrap:wrap;
}
.aktion .zweit a,
.aktion .zweit button{
  flex:1 1 30%;
  font-size:.76rem;
  padding:9px;
  border-radius:9px;
  background:var(--bg3);
  border:1px solid var(--line2);
  color:var(--fg2);
  cursor:pointer;
  font-family:inherit;
  text-align:center;
  text-decoration:none;
}
.aktion .tipp{
  font-size:.72rem;
  color:var(--fg3);
  margin-top:9px;
  line-height:1.5;
}
.fehlerbox{
  border:1px solid var(--err);
  background:#2a1310;
  border-radius:12px;
  padding:13px;
  margin-bottom:14px;
}
.fehlerbox h3{
  color:var(--err);
  margin:0 0 8px;
  text-transform:none;
  letter-spacing:0;
  font-size:.95rem;
}
.fehlerbox ul{
  margin:0 0 10px;
  padding-left:18px;
  font-size:.76rem;
  color:#f0b6ac;
  font-family:var(--mono);
}
.ausweich{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-bottom:10px;
}
.ausweich a{
  font-size:.76rem;
  padding:7px 10px;
  border-radius:8px;
  background:var(--bg3);
  border:1px solid var(--line2);
  color:var(--fg2);
}
.wartet{
  border-color:var(--warn);
  background:#241c08;
}
</style>
</head>
<body>

<header>
  <div class="kopf">
    <div class="logo">K</div>
    <h1>Kinolotse</h1>
    <span class="ver" id="ver">18</span>
  </div>
  <nav id="nav">
    <button data-page="suche" class="active">Suche</button>
    <button data-page="player">Player</button>
    <button data-page="download">Downloads</button>
    <button data-page="watchlist">Watchlist</button>
    <button data-page="verlauf">Verlauf</button>
    <button data-page="melden">Melden</button>
    <button data-page="statistik">Statistik</button>
    <button data-page="diagnose">Diagnose</button>
    <button data-page="einstellungen">Einstellungen</button>
    <button data-page="info">Info</button>
  </nav>
</header>

<main id="haupt"></main>

<footer>
  <div class="kopfkonsole">
    <span class="p"><i></i>Agent</span>
    <span id="status">bereit</span>
    <span id="zaehler" style="color:var(--fg3)">0 Treffer</span>
    <button id="konsole-leeren">leeren</button>
  </div>
  <div id="konsole"></div>
</footer>

<div id="toast"></div>

<noscript>
  <div style="padding:16px">JavaScript ist deaktiviert.</div>
</noscript>

<template data-page="suche">
  <div id="banner">Starte den Selbsttest …</div>
  <div class="feld">
    <input type="text" id="q" placeholder="Titel eingeben – Jahr, Qualität, Studio sind egal" autocomplete="off" enterkeyhint="search">
    <button class="btn" id="start">Suchen</button>
  </div>
  <div class="chips" id="vorschlaege"></div>
  <div class="reihe">
    <button class="btn ghost klein" id="jahr-weg">Titel bereinigen</button>
    <button class="btn ghost klein" id="abbrechen" disabled>Abbrechen</button>
    <button class="btn ghost klein" id="direkt-filter">Nur Direktlinks</button>
  </div>
  <div class="feld" id="serie-feld">
    <input type="text" id="s-staffel" placeholder="Staffel" autocomplete="off">
    <input type="text" id="s-folge" placeholder="Folge" autocomplete="off">
    <button class="btn ghost klein" id="serie-add">Serie übernehmen</button>
  </div>
  <div id="lauf">
    <div class="balken"><i id="lauf-balken"></i></div>
    <div id="lauf-text" class="hinweis">bereit</div>
    <div id="lauf-schritte" class="schritte"></div>
  </div>
  <div id="aktion"></div>
  <div class="chips az" id="az-filter"></div>
  <div class="chips" id="genre-filter"></div>
  <div class="feld">
    <select id="sortierung">
      <option value="score">Sortierung: Relevanz</option>
      <option value="titel">Sortierung: Titel A–Z</option>
      <option value="jahr">Sortierung: Jahr</option>
      <option value="portal">Sortierung: Quelle</option>
    </select>
  </div>
  <div id="treffer"><div class="leer">Noch keine Suche.</div></div>
</template>

<template data-page="player">
  <h2>Player</h2>
  <div class="feld">
    <input type="url" id="p-url" placeholder="https://…/video.mp4">
    <button class="btn" id="p-start">Abspielen</button>
  </div>
  <video id="p-video" controls playsinline preload="metadata"></video>
  <div class="reihe" style="margin-top:10px">
    <button class="btn ghost klein" id="p-download">In Downloads</button>
    <button class="btn ghost klein" id="p-kopie">Link kopieren</button>
    <button class="btn ghost klein" id="p-stop">Stoppen</button>
  </div>
  <div id="p-status" class="hinweis">Kein Medium geladen.</div>
</template>

<template data-page="download">
  <h2>Downloads</h2>
  <p class="hinweis">
    „Video speichern“ ist ein echter Link. Safari legt die Datei in „Dateien“ ab, von dort in Fotos importierbar.
    Fehlgeschlagene Einträge lassen sich einzeln wiederholen.
  </p>
  <div class="reihe">
    <button class="btn ghost klein" id="dl-leeren">Liste leeren</button>
    <button class="btn ghost klein" id="dl-wieder">Fehlgeschlagene wiederholen</button>
  </div>
  <div id="dl-liste"><div class="leer">Keine Dateien.</div></div>
</template>

<template data-page="watchlist">
  <h2>Watchlist</h2>
  <div class="feld">
    <input type="text" id="wl-ein" placeholder="Titel hinzufügen" autocomplete="off">
    <button class="btn" id="wl-add">Hinzufügen</button>
  </div>
  <div class="reihe">
    <button class="btn ghost klein" id="wl-alle">Alle prüfen</button>
    <button class="btn ghost klein" id="wl-leeren">Leeren</button>
  </div>
  <div id="wl-liste"><div class="leer">Watchlist ist leer.</div></div>
</template>

<template data-page="verlauf">
  <h2>Verlauf</h2>
  <div class="reihe"><button class="btn ghost klein" id="vh-leeren">Löschen</button></div>
  <div id="vh-liste"><div class="leer">Kein Verlauf.</div></div>
</template>

<template data-page="melden">
  <h2>Problem melden</h2>
  <p class="hinweis">Was nicht geklappt hat, landet hier und fließt in die Rangliste ein.</p>
  <label class="zeile">
    <span>Filmtitel</span>
    <input type="text" id="m-titel" placeholder="Um welchen Titel geht es?" autocomplete="off">
  </label>
  <label class="zeile">
    <span>Art des Problems</span>
    <select id="m-art">
      <option value="nichtgefunden">Film wurde nicht gefunden</option>
      <option value="falscherfilm">Falscher Film vorgeschlagen</option>
      <option value="hostertot">Hoster geht nicht</option>
      <option value="download">Download klappt nicht</option>
      <option value="absturz">Seite hängt oder Fehler</option>
      <option value="sonstiges">Sonstiges</option>
    </select>
  </label>
  <label class="zeile">
    <span>Quelle (optional)</span>
    <input type="text" id="m-quelle" placeholder="z. B. Vidoza oder Filmpalast" autocomplete="off">
  </label>
  <label class="zeile">
    <span>Beschreibung</span>
    <textarea id="m-text" placeholder="Was ist passiert?"></textarea>
  </label>
  <div class="reihe">
    <button class="btn" id="m-speichern">Meldung speichern</button>
